# ===== 数据库 =====
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=open_publisher_web
MYSQL_USER=opw
MYSQL_PASSWORD=change_me_opw

# 后端本地直连时使用
# DATABASE_URL=mysql+pymysql://opw:change_me_opw@localhost:3306/open_publisher_web?charset=utf8mb4
# REDIS_URL=redis://localhost:6379/0

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ===== LLM（非敏感默认配置；API Key 只在管理端加密入库）=====
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120

# ===== 独立生图模型（非敏感默认配置） =====
IMAGE_BASE_URL=
IMAGE_MODEL=gpt-image-1
IMAGE_TIMEOUT_SECONDS=180

# ===== RAG（混合检索 + 重排）=====
# 嵌入模型（OpenAI 兼容 /embeddings；密钥复用 LLM 档案，仅存数据库）
RAG_EMBEDDING_MODEL=text-embedding-3-small
# 检索返回片段数
RAG_TOP_K=5
# TEI bge-reranker 服务地址（scripts/rerank.ps1 start 后生效）
RERANK_BASE_URL=http://localhost:8080

# ===== 登录认证 =====
AUTH_JWT_SECRET=change_me_long_random_secret
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change_me_admin_password

# ===== 密钥信封主密钥（必填；加密 app_secrets；生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"）=====
SECRET_ENCRYPTION_KEY=

# ===== 安全加固（2026-10-26）=====
# 令牌有效期（分钟），生产建议 120 以内
ACCESS_TOKEN_EXPIRE_MINUTES=120
# 登录/注册限流：窗口内按 IP 计数，超限返回 429
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
